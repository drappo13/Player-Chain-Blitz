rules_version = '2';

// Mirror of the rules in the Firebase console (publish there; this copy is what the
// emulator tests in CI run against — keep them identical).
service cloud.firestore {
  match /databases/{database}/documents {

    function isGuestDoc() {
      return resource.data.username is string && resource.data.username.matches('guest-.*');
    }
    // Picking a name: a guest's game can be marked claimedBy, and nothing else about it changes
    function onlyClaiming() {
      return isGuestDoc() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if true;
      allow update: if onlyClaiming();
      allow delete: if false;
    }

    match /daily-scores/{docId} {
      allow read: if true;
      allow create: if true;
      // CentreCircle/Griddle save as you go: only an open score can be updated, it can only go up,
      // and it can't be moved to another player/game/day. Finished scores stay locked.
      // Guest games can also be marked claimedBy when the guest picks a name.
      allow update: if (resource.data.open == true
          && request.resource.data.score >= resource.data.score
          && request.resource.data.key == resource.data.key
          && request.resource.data.username == resource.data.username)
        || onlyClaiming();
      allow delete: if false;
    }

    match /friends/{username} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /guest-plays/{playId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /push-subs/{username} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Anonymous quiz-play tracking (Arsenal quiz). Read-only on the server side;
    // the client never reads this collection, only writes to it for analytics.
    match /quiz_plays/{playId} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
